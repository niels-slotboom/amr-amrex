CompileFlags:
  CompilationDatabase: "build"
  Add:
    - "-std=c++20"
    - "-x"
    - "cuda"
    - "--cuda-host-only"
    - "-Wno-unknown-cuda-version"
    - "-Wno-deprecated-attributes"
---
If:
  PathMatch: .*\.hpp
CompileFlags:
  Add:
    - "-std=c++20"
    - "-x"
    - "cuda"
    - "--cuda-host-only"
    - "-Wno-unknown-cuda-version"
    - "-Wno-deprecated-attributes"